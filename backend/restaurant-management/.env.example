# Supply these through your shell/IDE; Spring does not automatically load .env.
DB_URL=jdbc:postgresql://localhost:5432/restaurant
DB_USERNAME=postgres
DB_PASSWORD=replace-me
# Base64-encoded cryptographically random key of at least 32 bytes.
JWT_SECRET=replace-me
PAYPAL_CLIENT_ID=replace-me
PAYPAL_SECRET=replace-me
PAYPAL_MODE=SANDBOX
RESTAURANT_CURRENCY=USD
FRONTEND_URL=http://localhost:5173
# false only for local HTTP development
COOKIE_SECURE=false
# Only for upgrading existing payments: verify their actual historical currency.
LEGACY_PAYMENT_CURRENCY=USD
